# LLM: auto | groq | ollama
LLM_PROVIDER=auto

# Free cloud LLM: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Free local LLM (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Free jobs: https://developer.adzuna.com/signup
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Country for Adzuna: in = India, gb = UK, us = USA
ADZUNA_COUNTRY=in
